rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for secure multi-tenancy & RBAC
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function belongsToOrg(orgId) {
      return isAuthenticated() && getUserData().organizationId == orgId;
    }

    function isSuperUser(orgId) {
      return belongsToOrg(orgId) && (
        getUserData().roleType == 'OWNER' ||
        getUserData().roleType == 'SUPER_ADMIN' ||
        getUserData().isOwner == true
      );
    }

    function isHR(orgId) {
      return isSuperUser(orgId) || (belongsToOrg(orgId) && getUserData().roleType == 'HR_ADMIN');
    }

    function isManager(orgId) {
      return belongsToOrg(orgId) && (getUserData().roleType == 'DEPT_MANAGER' || isHR(orgId));
    }

    // Top-Level User Profile Collection
    match /users/{userId} {
      // User can read and write only their own profile document; HR can read all users in their org
      allow read: if isAuthenticated() && (request.auth.uid == userId || isHR(resource.data.organizationId));
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Prevent user from elevating their own roleType to OWNER/ADMIN or changing organizationId
      allow update: if isAuthenticated() && (
        isSuperUser(resource.data.organizationId) ||
        (isHR(resource.data.organizationId) && 
         resource.data.roleType != 'OWNER' && resource.data.roleType != 'SUPER_ADMIN' && resource.data.isOwner != true &&
         request.resource.data.roleType != 'OWNER' && request.resource.data.roleType != 'SUPER_ADMIN' && request.resource.data.isOwner == resource.data.isOwner) ||
        (request.auth.uid == userId && 
         request.resource.data.roleType == resource.data.roleType && 
         request.resource.data.organizationId == resource.data.organizationId &&
         request.resource.data.isOwner == resource.data.isOwner)
      );
      allow delete: if isAuthenticated() && (
        isSuperUser(resource.data.organizationId) || 
        (isHR(resource.data.organizationId) && resource.data.roleType != 'OWNER' && resource.data.roleType != 'SUPER_ADMIN' && resource.data.isOwner != true)
      );
    }

    // Tenant Root & Subcollections
    match /organizations/{orgId} {
      allow read: if belongsToOrg(orgId);
      allow create: if isAuthenticated(); // New company creation during signup
      allow update, delete: if isSuperUser(orgId);

      // Employees Collection
      match /employees/{employeeId} {
        allow read: if belongsToOrg(orgId);
        allow create, update, delete: if isHR(orgId);
      }

      // Attendance Records
      match /attendance/{attendanceId} {
        allow read: if belongsToOrg(orgId);
        allow create: if belongsToOrg(orgId);
        allow update: if isManager(orgId);
      }

      // Leave Requests
      match /leaveRequests/{leaveId} {
        allow read: if belongsToOrg(orgId);
        allow create: if belongsToOrg(orgId);
        allow update: if isManager(orgId);
      }

      // Payroll Records (High Security - Philippines Statutory & Net Pay)
      match /payroll/{payrollId} {
        allow read, write: if isHR(orgId);
      }

      // Payslips (Confidential - Employee can read own, Admin can read/write all)
      match /payslips/{payslipId} {
        allow read: if belongsToOrg(orgId) && (resource.data.employeeId == getUserData().employeeId || isHR(orgId));
        allow write: if isHR(orgId);
      }

      // Workflows & Tasks
      match /workflows/{workflowId} {
        allow read: if belongsToOrg(orgId);
        allow write: if isHR(orgId);
      }

      match /tasks/{taskId} {
        allow read, update: if belongsToOrg(orgId);
        allow create, delete: if isManager(orgId);
      }
    }

    // Top-level Audit Log (Immutable: Append-only by privileged functions/users)
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && getUserData().organizationId == resource.data.organizationId && isHR(resource.data.organizationId);
      allow create: if isAuthenticated() && getUserData().organizationId == request.resource.data.organizationId;
      allow update, delete: if false; // NEVER allow updates or deletions to audit trail
    }

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
